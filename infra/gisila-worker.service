[Unit]
Description=Gisila Panel — background worker
# Ordering only, no Requires= — see the comment in gisila-panel.service:
# Postgres and Redis may be remote, in which case these units don't exist here.
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
PartOf=gisila-panel.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/srv/gisila
EnvironmentFile=/etc/gisila/.env
# Run the agent directly — no sudo required because the worker itself is root.
# This works on all VPS providers, including those that enforce the kernel-level
# no_new_privileges flag (Hetzner, DigitalOcean, Linode, etc.) which would
# block sudo even when NoNewPrivileges=false is set in this unit.
Environment=AGENT_MODE=direct
ExecStart=/usr/local/bin/gisila-worker
Restart=on-failure
RestartSec=5
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
