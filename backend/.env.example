PORT=8000

# Required. The panel refuses to start while this is unset or the placeholder
# below. Generate one with: head -c 32 /dev/urandom | base64
JWT_SECRET=change-me-to-a-random-secret-please
JWT_EXPIRE_DAYS=14

# GisilaStudio — the raw database admin UI at /admin. Off unless set to 1.
# It is only mounted with a STUDIO_PASSWORD that is set and not a default
# such as "admin".
STUDIO_ENABLED=0
STUDIO_USERNAME=admin
STUDIO_PASSWORD=

# PostgreSQL and Redis are external services this panel connects to — neither
# is installed or managed by infra/install.sh. Postgres connection details go
# in database.yaml (see backend/database.yaml for the dev default); Redis is
# configured here.
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# Host paths that the worker will hand to the agent.
APPS_ROOT=/srv/apps
NGINX_SITES_DIR=/etc/nginx/sites-enabled
SYSTEMD_UNITS_DIR=/etc/systemd/system
APPARMOR_PROFILES_DIR=/etc/apparmor.d

# Internal port range allocated to user apps.
APP_PORT_RANGE_MIN=4000
APP_PORT_RANGE_MAX=4999

# How to talk to the agent (unix socket or sudo CLI).
AGENT_MODE=sudo
AGENT_BIN=/usr/local/bin/gisila-agent

# Default node identifier (room for future multi-node).
NODE_ID=local

# Public address shown in the panel for pointing DNS at this server. Leave
# unset to detect it automatically (set it behind NAT or with several IPs).
PUBLIC_IP=
